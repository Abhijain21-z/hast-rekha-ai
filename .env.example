# PostgreSQL connection string.
# Local:  postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Vercel: paste your Neon / Supabase / Vercel Postgres URL (with sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: your production domain — used for sitemap.xml, canonical/OG URLs.
# e.g. https://hast-rekha-ai.vercel.app  or your custom domain
NEXT_PUBLIC_SITE_URL=https://hastrekha.ai
